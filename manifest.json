{
  "manifest_version": 3,
  "minimum_chrome_version": "114",
  "name": "Selection Text Reader",
  "description": "Read selected text aloud in its original language or translate and read it.",
  "version": "2.6.11",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png",
    "256": "assets/icons/icon-256.png",
    "512": "assets/icons/icon-512.png"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "offscreen",
    "scripting",
    "storage",
    "tts"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://translate.googleapis.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'; connect-src 'self' https://translate.googleapis.com data: blob:; img-src 'self' data: blob:"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["i18n.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "24": "assets/icons/icon-24.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "64": "assets/icons/icon-64.png"
    },
    "default_title": "Selection Text Reader",
    "default_popup": "popup.html"
  },
  "commands": {
    "read-selection": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Read selected text"
    },
    "toggle-pause": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Pause or resume reading"
    },
    "stop-reading": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Stop reading"
    }
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icons/icon-16.png",
        "assets/icons/icon-24.png",
        "assets/icons/icon-32.png",
        "assets/icons/icon-48.png"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
